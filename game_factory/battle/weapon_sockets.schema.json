{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle weapon sockets",
  "description": "One socket per attack frame. Coordinates are sprite-local pixels; rotation is in degrees, inclusive from -180 to 180. Provenance records annotation or measurement evidence; it does not certify that evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attack_id", "frames"],
  "properties": {
    "attack_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "description": "Include every attack frame exactly once. Frame names must be unique within the attack; the Python validator enforces this cross-record constraint.",
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_name", "weapon_id", "socket", "layer", "provenance"],
      "properties": {
        "frame_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "weapon_id": {
          "enum": ["WPN_HERO_BASIC_SWORD", "WPN_IRON_SWORD"]
        },
        "socket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "rotation_deg"],
          "properties": {
            "x": {
              "type": "number",
              "description": "Finite sprite-local pixel coordinate."
            },
            "y": {
              "type": "number",
              "description": "Finite sprite-local pixel coordinate."
            },
            "rotation_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "layer": {
          "enum": ["behind_hand", "in_hand", "front"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "reference"],
          "properties": {
            "method": {
              "enum": ["annotation", "measurement"]
            },
            "reference": {
              "type": "string",
              "pattern": "\\S",
              "description": "Non-empty annotation or measurement reference supporting this frame's socket."
            }
          }
        }
      }
    }
  }
}
