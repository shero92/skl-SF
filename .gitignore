# Godot 4 project cache (regenerated locally)
.godot/
# Older Godot import cache
.import/
# Binary translation outputs generated from CSV sources
*.translation

# Screenshots in docs/previews are reference/QA files, not Godot textures.
# They are hidden from Godot's importer via docs/previews/.gdignore.
docs/previews/**/*.import

# Python and local tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local Claude Code worktrees (claude -p runs); task worktrees live outside the repo
.claude/worktrees/

# Temporary editor and operating system files
*.tmp
*.bak
*.swp
*.swo
*.log
.DS_Store
Thumbs.db

# DO NOT ignore *.png.import, *.gd.uid, *.png, *.gd, *.tscn,
# *.tres, project.godot, or map_factory's source JSON/CSV files.

# Local Claude Code settings are machine-specific; not shared.
.claude/settings.local.json

# Never commit agent conversations, raw JSONL transcripts or local usage snapshots
.agents/monitoring/.local/
.aider*

# Owner HD masters stay local (about 230 MB, see assets_hd/RULES.md); only assets_hd/runtime is tracked.
assets_hd/*/
!assets_hd/runtime/

# Duplicate preview copies of the character design posters (same files live in assets/characters)
game_factory/characters/*/previews/

# Godot import metadata of untracked local reference images
/map_factory/references/approved/G0?.png.png.import
/map_factory/references/original_room.png.png.import
