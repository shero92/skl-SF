{
  "description": "Observe task usage for locally trusted Codex project sessions.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/agent_costs_hook.sh hook --agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/agent_costs_hook.sh hook --agent codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
