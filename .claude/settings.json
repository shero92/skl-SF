{
  "statusLine": {
    "type": "command",
    "command": "py -3 tools/agent_costs.py hook --agent claude --statusline"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 tools/agent_costs.py hook --agent claude",
            "shell": "powershell"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 tools/agent_costs.py hook --agent claude",
            "shell": "powershell"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./map_factory/parts/**)",
      "Read(./map_factory/references/**)",
      "Read(./docs/previews/**)",
      "Read(./.agents/graphics/deliveries/**)",
      "Read(./.agents/planner/goals/**/references/**)",
      "Read(./map_factory/**/*.png)",
      "Read(./map_factory/**/*.jpg)",
      "Read(./map_factory/**/*.jpeg)",
      "Read(./map_factory/**/*.svg)",
      "Read(./map_factory/**/*.webp)"
    ]
  }
}
